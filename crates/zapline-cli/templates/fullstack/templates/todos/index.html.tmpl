{% extends "base.html" %}
{% block title %}Todos · @@name@@{% endblock %}
{% block content %}
<h1>Todos</h1>

{# A rejected post re-renders the `form` block here (422), not the list. #}
<form id="todo-form" method="post" action="/todos" hx-post="/todos" hx-target="#todos"
      hx-on::after-request="if (event.detail.xhr.status < 300) { this.reset(); this.querySelectorAll('.error').forEach((e) => e.remove()) }">
  {% block form %}
  <input name="title" placeholder="What needs doing?" value="{{ old.title }}" required maxlength="200" autofocus{% if errors.title %} aria-invalid="true"{% endif %}>
  <button>Add</button>
  {% if errors.title %}<small class="error">Title {{ errors.title }}</small>{% endif %}
  {% endblock %}
</form>

{# Live: other tabs and users see changes as they happen. #}
<ul id="todos" hx-ext="sse" sse-connect="/live/todos" sse-swap="list">
  {% block list %}
  {% for todo in todos %}
  <li class="{{ 'done' if todo.done }}">
    <label>
      <input type="checkbox" {{ 'checked' if todo.done }}
             hx-post="/todos/{{ todo.id }}/toggle" hx-target="#todos">
      {{ todo.title }}
    </label>
    <button class="link" hx-delete="/todos/{{ todo.id }}" hx-target="#todos" aria-label="Delete">✕</button>
  </li>
  {% else %}
  <li class="empty">Nothing to do yet.</li>
  {% endfor %}
  {% endblock %}
</ul>

<p><small>JSON API and interactive docs at <a href="/docs">/docs</a>.</small></p>
{% endblock %}
