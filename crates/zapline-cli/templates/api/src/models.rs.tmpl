//! Data types shared by the routes.
//!
//! `#[model]` derives serde, `JsonSchema` (which feeds the generated
//! OpenAPI document) and, for types with `#[validate]` rules, `Validate`
//! (which powers `Valid<Json<T>>`, rejecting bad input with a descriptive
//! error before your handler runs).

use zapline::model;

/// A user as stored and returned by the API.
#[model]
#[derive(PartialEq)]
pub struct User {
    pub id: u64,
    pub name: String,
    pub email: String,
}

/// Payload for creating or replacing a user.
#[model]
pub struct NewUser {
    #[validate(length(min = 1, max = 100))]
    pub name: String,
    #[validate(email)]
    pub email: String,
}

/// Query parameters for `GET /users`.
#[model]
pub struct Pagination {
    /// Maximum number of users to return (default 50, at most 200).
    pub limit: Option<usize>,
    /// Number of users to skip (default 0).
    pub offset: Option<usize>,
}
