[package]
name = "@@name@@"
version = "0.1.0"
edition = "2021"
rust-version = "1.88"
publish = false

[dependencies]
zapline = @@zapline@@
serde = { version = "1", features = ["derive"] }
schemars = "1"
validator = { version = "0.21", features = ["derive"] }

[dev-dependencies]
serde_json = "1"
tokio = { version = "1", features = ["full"] }

[profile.release]
lto = "thin"
codegen-units = 1
