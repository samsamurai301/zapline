    store.get(id).map(Json).ok_or_else(Error::not_found)
}

/// Create a @@human@@.
#[post("@@path@@")]
async fn create_@@singular@@(
    State(store): State<@@pascal@@Store>,
    Valid(Json(new)): Valid<Json<New@@pascal@@>>,
