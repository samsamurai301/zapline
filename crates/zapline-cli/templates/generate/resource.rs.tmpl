/// Replace a @@human@@.
#[put("@@path@@/{id}")]
async fn replace_@@singular@@(
    State(store): State<@@pascal@@Store>,
    Path(id): Path<u64>,
    Valid(Json(new)): Valid<Json<New@@pascal@@>>,
) -> Result<Json<@@pascal@@>> {
    let item = store.replace(id, new).ok_or_else(Error::not_found)?;
    Ok(Json(item))
}

/// Delete a @@human@@.
#[delete("@@path@@/{id}")]
async fn delete_@@singular@@(
    State(store): State<@@pascal@@Store>,
    Path(id): Path<u64>,
) -> Result<StatusCode> {
    if store.delete(id) {
        Ok(StatusCode::NO_CONTENT)
    } else {
        Err(Error::not_found())
    }
}

/// Adds the `@@path@@` routes and their store.
pub fn mount(app: App) -> App {
    app.state(@@pascal@@Store::default()).mount((
        list_@@plural@@,
        get_@@singular@@,
        create_@@singular@@,
        replace_@@singular@@,
        delete_@@singular@@,
    ))
}
