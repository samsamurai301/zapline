{% extends "base.html" %}
{% block title %}Two-factor login · @@package@@{% endblock %}
{% block content %}
<h1>Enter your code</h1>
<p>Open your authenticator app and enter the six-digit code for @@package@@.</p>

<form method="post" action="/login/2fa" hx-post="/login/2fa">
  {% block form %}
  <label>Code <input name="code" inputmode="numeric" autocomplete="one-time-code" required minlength="6" maxlength="32" autofocus{% if errors.code %} aria-invalid="true"{% endif %}></label>
  {% if errors.code %}<small class="error">That code {{ errors.code }}</small>{% endif %}
  <button>Log in</button>
  {% endblock %}
</form>

<p><small>Lost your phone? Enter one of your recovery codes instead. · <a href="/login">Start over</a></small></p>
{% endblock %}
