        Err(_) => String::new(),
    };
    match disable_two_factor(&db, &session, &user, &code).await {
        Ok(()) => {
            flash.info("Two-factor login is off.");
            Ok(flash.redirect("/account/security"))
        }
        Err(e) if e.code() == Some("code_invalid") => {
            let errors = FormErrors::one("code", "isn't right");
            views.render_invalid("auth/security.html", context! { enabled => true }, Invalid { errors, ..Invalid::default() })
        }
        Err(e) => Err(e),
    }
}
