/// Session key holding the logged-in user's id.
const USER_ID: &str = "user_id";
/// Session key holding `users.session_version` at log-in. Changing the
/// password bumps the column, which logs out every other session.
const SESSION_VERSION: &str = "session_version";

/// Providers offered when their `{NAME}_CLIENT_ID`/`_SECRET` are set.
const PROVIDERS: [(&str, &str); 2] = [("github", "GitHub"), ("google", "Google")];

/// The configured providers as `(slug, label)`, for the log-in page.
#[derive(Clone, Debug, Default)]
pub struct SocialLogins(pub Vec<(&'static str, &'static str)>);

/// How long a password-reset link works.
const RESET_TTL: Duration = Duration::from_secs(60 * 60);
/// How long an emailed sign-in link works.
const LINK_TTL: Duration = Duration::from_secs(15 * 60);

/// Session keys for a sign-in waiting for its second factor: who, and since
/// when (it expires after `PENDING_TTL`).
const PENDING_USER: &str = "pending_user_id";
const PENDING_AT: &str = "pending_since";
const PENDING_TTL: Duration = Duration::from_secs(5 * 60);
/// Session key for a TOTP secret being set up, until a code confirms it.
const SETUP_SECRET: &str = "totp_setup_secret";
/// How many recovery codes a user gets.
const RECOVERY_CODES: usize = 10;

/// A registered user.
#[model]
#[derive(sqlx::FromRow)]
pub struct User {
    pub id: i64,
    pub email: String,
}

/// Email and password, to sign up or log in (JSON or an HTML form).
#[model]
pub struct Credentials {
    #[validate(email)]
    pub email: String,
    #[validate(length(min = 8, max = 128))]
    pub password: String,
}

/// Asks for a password-reset link.
#[model]
pub struct ForgotPassword {
    #[validate(email)]
    pub email: String,
}

/// Sets a new password with the token from a reset link.
#[model]
pub struct ResetPassword {
    pub token: String,
    #[validate(length(min = 8, max = 128))]
    pub password: String,
}

/// A code from an authenticator app, or a recovery code.
#[model]
pub struct TwoFactorCode {
    #[validate(length(min = 6, max = 32))]
    pub code: String,
}

/// What an authenticator app needs: the `otpauth://` URI (show it as a QR
/// code) and the secret (for typing in by hand).
#[model]
pub struct TwoFactorSetup {
    pub secret: String,
    pub otpauth_uri: String,
}

/// One-time recovery codes, shown once when two-factor login is turned on.
#[model]
pub struct RecoveryCodes {
    pub recovery_codes: Vec<String>,
}

/// The logged-in user, as a handler argument. Rejects with
/// `401 login_required` when nobody is logged in.
#[derive(Clone, Debug)]
pub struct CurrentUser(pub User);

impl FromRequestParts for CurrentUser {
    async fn from_request_parts(req: &mut Request) -> Result<Self> {
        let session = Session::from_request_parts(req).await?;
        let db = Db::from_request_parts(req).await?;
        let Some(id) = session.get::<i64>(USER_ID) else {
            return Err(login_required());
        };
        let row = sqlx::query_as::<_, (i64, String, i64)>(
            "SELECT id, email, session_version FROM users WHERE id = $1",
        )
        .bind(id)
        .fetch_optional(&*db)
        .await?;
        match row {
            Some((id, email, version)) if session.get::<i64>(SESSION_VERSION) == Some(version) => {
                Ok(CurrentUser(User { id, email }))
            }
            // The account was deleted, or its password changed since this
            // session logged in: forget the session.
            _ => {
                session.destroy();
                Err(login_required())
            }
        }
    }
}

/// Routes taking a `CurrentUser` document their `401` in OpenAPI (and so
/// to `zapline fuzz`).
impl zapline::openapi::ApiInput for CurrentUser {
    fn describe_input(op: &mut zapline::openapi::OperationDoc) {
        op.error_response(401, "Not logged in");
    }
}

/// Lets only the accounts listed in `ADMIN_EMAILS` into the admin panel.
async fn admins_only(mut req: Request, next: Next) -> Response {
    let user = match CurrentUser::from_request_parts(&mut req).await {
        Ok(CurrentUser(user)) => user,
        // @@html
        Err(_) => return Redirect::to("/login").into_response(),
        // html@@
        // @@api
        Err(e) => return e.into_response(),
        // api@@
    };
    let admins = std::env::var("ADMIN_EMAILS").unwrap_or_default();
    if !admins.split(',').any(|email| email.trim().eq_ignore_ascii_case(&user.email)) {
        return Error::forbidden().into_response();
    }
    let Ok(db) = Db::from_request_parts(&mut req).await else {
        return Error::forbidden().into_response();
    };
    let verified: Option<bool> = sqlx::query_scalar("SELECT email_verified FROM users WHERE id = $1")
        .bind(user.id)
        .fetch_optional(&*db)
        .await
        .unwrap_or(None);
    if verified != Some(true) {
        return Error::forbidden()
            .with_code("email_unverified")
            .into_response();
    }
    next.run(req).await
}

/// At most 10 sign-ups, log-ins and reset requests a minute per client IP:
/// slows password guessing and floods of reset emails. Behind a proxy, list
/// it in `TRUSTED_PROXIES`, or every client shares the proxy's allowance.
fn throttle() -> RateLimit {
    let proxies = TrustedProxies::from_env().unwrap_or_else(|e| panic!("{}", e.message()));
    RateLimit::per_ip(10, Duration::from_secs(60)).trusted_proxies(proxies)
}

fn login_required() -> Error {
    Error::unauthorized().with_code("login_required")
}

/// Adds sessions, the mailer and the account routes.
pub fn mount(app: App) -> App {
    // @@own_sessions
    let key = key_from_env("SESSION_SECRET").unwrap_or_else(|e| panic!("{}", e.message()));
    // own_sessions@@
    let mailer = Mailer::from_env().unwrap_or_else(|e| panic!("{}", e.message()));
    let mut app = app
        // @@own_sessions
        .cookie_key(key)
        // own_sessions@@
        // Form posts and fetches from other sites can't act with a user's
        // session cookie (403): CSRF protection without tokens in forms.
        .wrap(SameOrigin::new())
        // @@own_sessions
        // `Secure` cookies in release builds (HTTPS); plain HTTP while developing.
        .database_sessions(|layer| layer.secure(!cfg!(debug_assertions)))
        // own_sessions@@
        .mailer(mailer)
        // Sign-up, log-in, second factors, sign-in links and password
        // resets, rate-limited per client: each guesses a secret or sends mail.
        .nest(
            "/",
            Routes::new()
                .mount((signup, login, forgot, reset))
                .mount((two_factor, send_link, open_link))
                // @@html
                .mount((signup_form, login_form, forgot_form, reset_form))
                .mount((two_factor_form, link_form, link_open))
                // html@@
                .wrap(throttle()),
        )
        .mount((logout, me))
        .mount((two_factor_setup, two_factor_enable, two_factor_disable))
        // @@html
        .mount((signup_page, login_page, logout_form, forgot_page, reset_page))
        .mount((two_factor_page, link_page, security_page))
        .mount((security_setup, security_enable, security_disable))
        // html@@
        .mount((github_callback, google_callback))
        .admin(|admin| admin.protect(admins_only).exclude(["password_resets"]));
    let mut social = SocialLogins::default();
    for (name, label) in PROVIDERS {
        if let Ok(provider) = OAuth::from_env(name) {
            app = app.oauth(provider);
            social.0.push((name, label));
        }
    }
    app.state(social)
}

// ---- accounts -----------------------------------------------------------------

/// Creates the account and logs it in.
async fn register(db: &Db, session: &Session, creds: &Credentials) -> Result<User> {
    let email = creds.email.trim().to_lowercase();
    let hash = password::hash(creds.password.as_str()).await?;
    let user = sqlx::query_as::<_, User>(
        "INSERT INTO users (email, password_hash) VALUES ($1, $2) RETURNING id, email",
    )
    .bind(&email)
    .bind(&hash)
    .fetch_one(&**db)
    .await
    .map_err(|e| match Error::from(e) {
        e if e.code() == Some("unique_violation") => Error::conflict("this email is already registered")
            .with_code("email_taken"),
        e => e,
    })?;
    start_session(db, session, &user).await?;
    Ok(user)
}

/// Checks the password and logs the user in.
async fn authenticate(db: &Db, session: &Session, creds: &Credentials) -> Result<User> {
    let email = creds.email.trim().to_lowercase();
    let row = sqlx::query_as::<_, (i64, String, String)>(
        "SELECT id, email, password_hash FROM users WHERE email = $1",
    )
    .bind(&email)
    .fetch_optional(&**db)
    .await?;
    let Some((id, email, hash)) = row else {
        // Take as long as a real check, so timing doesn't reveal unknown emails.
        password::verify_missing(creds.password.as_str()).await?;
        return Err(invalid_credentials());
    };
    if !password::verify(creds.password.as_str(), hash).await? {
        return Err(invalid_credentials());
    }
    sign_in(db, session, User { id, email }).await
}

/// Logs in the account linked to this GitHub/Google identity. The first
/// time, links it to the account with the same verified email, or creates
/// one (without a password: "Forgot your password?" sets one). An account
/// whose owner never proved that email may have been opened by someone else
/// to wait for the real owner, so linking it drops its password and logs out
/// its sessions.
async fn social_login(db: &Db, session: &Session, oauth: &OAuthLogin) -> Result<User> {
    let who = &oauth.user;
    let linked = sqlx::query_as::<_, User>(
        "SELECT users.id, users.email FROM oauth_accounts \
         JOIN users ON users.id = oauth_accounts.user_id \
         WHERE oauth_accounts.provider = $1 AND oauth_accounts.provider_id = $2",
    )
    .bind(&who.provider)
    .bind(&who.id)
    .fetch_optional(&**db)
    .await?;
    let user = match linked {
        Some(user) => user,
        None => {
            let Some(email) = who.email.as_deref().filter(|_| who.email_verified) else {
                return Err(Error::bad_request("that account has no verified email address")
                    .with_code("email_unverified"));
            };
            let email = email.trim().to_lowercase();
            let existing = sqlx::query_as::<_, User>("SELECT id, email FROM users WHERE email = $1")
                .bind(&email)
                .fetch_optional(&**db)
                .await?;
            let unusable = password::hash(&password::new_token()?).await?;
            let user = match existing {
                Some(user) => {
                    sqlx::query(
                        "UPDATE users SET password_hash = $1, session_version = session_version + 1, \
                         email_verified = TRUE WHERE id = $2 AND email_verified = FALSE",
                    )
                    .bind(&unusable)
                    .bind(user.id)
                    .execute(&**db)
                    .await?;
                    user
                }
                None => {
                    sqlx::query_as::<_, User>(
                        "INSERT INTO users (email, password_hash, email_verified) VALUES ($1, $2, TRUE) \
                         RETURNING id, email",
                    )
                    .bind(&email)
                    .bind(&unusable)
                    .fetch_one(&**db)
                    .await?
                }
            };
            sqlx::query("INSERT INTO oauth_accounts (provider, provider_id, user_id) VALUES ($1, $2, $3)")
                .bind(&who.provider)
                .bind(&who.id)
                .bind(user.id)
                .execute(&**db)
                .await?;
            user
        }
    };
    sign_in(db, session, user).await
}

/// Signs `user` in, or, when they have two-factor login on, starts the
/// second step: the session remembers who is half-way for `PENDING_TTL`,
/// and the code goes to `POST /api/auth/2fa` (or the `/login/2fa` page).
/// Every way of signing in comes through here.
async fn sign_in(db: &Db, session: &Session, user: User) -> Result<User> {
    let secret: Option<String> = sqlx::query_scalar("SELECT totp_secret FROM users WHERE id = $1")
        .bind(user.id)
        .fetch_one(&**db)
        .await?;
    if secret.is_some() {
        session.regenerate();
        session.remove(USER_ID);
        session.remove(SESSION_VERSION);
        session.insert(PENDING_USER, user.id)?;
        session.insert(PENDING_AT, unix_now())?;
        return Err(two_factor_required());
    }
    start_session(db, session, &user).await?;
    Ok(user)
}

async fn start_session(db: &Db, session: &Session, user: &User) -> Result<()> {
    // Counting the sign-in also uses up any emailed sign-in link.
    let version: i64 = sqlx::query_scalar(
        "UPDATE users SET login_count = login_count + 1 WHERE id = $1 RETURNING session_version",
    )
    .bind(user.id)
    .fetch_one(&**db)
    .await?;
    // A fresh session id on login prevents session fixation.
    session.regenerate();
    session.remove(PENDING_USER);
    session.remove(PENDING_AT);
    session.insert(USER_ID, user.id)?;
    session.insert(SESSION_VERSION, version)
}

fn two_factor_required() -> Error {
    Error::new(StatusCode::UNAUTHORIZED, "enter the code from your authenticator app")
        .with_code("two_factor_required")
}

fn code_invalid() -> Error {
    Error::new(StatusCode::UNAUTHORIZED, "that code isn't right").with_code("code_invalid")
}

// ---- two-factor login ------------------------------------------------------------

/// A user's two-factor columns.
#[derive(sqlx::FromRow)]
struct TwoFactorState {
    email: String,
    totp_secret: Option<String>,
    totp_last_step: Option<i64>,
    recovery_codes: String,
}

async fn two_factor_state(db: &Db, id: i64) -> Result<Option<TwoFactorState>> {
    Ok(sqlx::query_as::<_, TwoFactorState>(
        "SELECT email, totp_secret, totp_last_step, recovery_codes FROM users WHERE id = $1",
    )
    .bind(id)
    .fetch_optional(&**db)
    .await?)
}

/// Uses up `code` for user `id`: a TOTP code newer than the last accepted
/// one, or an unused recovery code. The update is conditional on the row
/// still holding what was read, so two requests can't use one code. Returns
/// whether the code was accepted.
async fn use_code(db: &Db, id: i64, state: &TwoFactorState, code: &str) -> Result<bool> {
    let Some(secret) = &state.totp_secret else {
        return Ok(false);
    };
    let totp = Totp::from_base32(secret)?;
    let last = state.totp_last_step.map(|s| s as u64);
    if let Some(step) = totp.verify(code, last) {
        let used = sqlx::query(
            "UPDATE users SET totp_last_step = $1 \
             WHERE id = $2 AND (totp_last_step IS NULL OR totp_last_step < $1)",
        )
        .bind(step as i64)
        .bind(id)
        .execute(&**db)
        .await?;
        return Ok(used.rows_affected() == 1);
    }
    let mut hashes: Vec<String> = state.recovery_codes.lines().map(str::to_owned).collect();
    if let Some(i) = recovery_codes::find(code, &hashes) {
        hashes.remove(i);
        let used = sqlx::query("UPDATE users SET recovery_codes = $1 WHERE id = $2 AND recovery_codes = $3")
            .bind(hashes.join("\n"))
            .bind(id)
            .bind(&state.recovery_codes)
            .execute(&**db)
            .await?;
        return Ok(used.rows_affected() == 1);
    }
    Ok(false)
}

/// The second step of signing in: checks the code for the pending sign-in
/// and completes it.
async fn complete_two_factor(db: &Db, session: &Session, code: &str) -> Result<User> {
    let (Some(id), Some(since)) = (session.get::<i64>(PENDING_USER), session.get::<i64>(PENDING_AT)) else {
        return Err(login_required());
    };
    if unix_now() - since > PENDING_TTL.as_secs() as i64 {
        session.remove(PENDING_USER);
        session.remove(PENDING_AT);
        return Err(login_required());
    }
    let Some(state) = two_factor_state(db, id).await? else {
        return Err(login_required());
    };
    if !use_code(db, id, &state, code).await? {
        return Err(code_invalid());
    }
    let user = User { id, email: state.email };
    start_session(db, session, &user).await?;
    Ok(user)
}

/// The name authenticator apps show for this app (`APP_NAME`).
fn issuer() -> String {
    std::env::var("APP_NAME").unwrap_or_else(|_| "@@package@@".into())
}

/// Starts turning two-factor login on: a new secret, kept in the session
/// until a code from the user's app confirms it.
fn begin_two_factor(session: &Session, user: &User) -> Result<TwoFactorSetup> {
    let totp = Totp::generate();
    session.insert(SETUP_SECRET, totp.secret_base32())?;
    Ok(TwoFactorSetup {
        secret: totp.secret_base32(),
        otpauth_uri: totp.otpauth_uri(&issuer(), &user.email),
    })
}

/// Turns two-factor login on once `code` proves the app is set up, and
/// returns the recovery codes (shown once; only their hashes are stored).
/// Other sessions of the account end.
async fn enable_two_factor(db: &Db, session: &Session, user: &User, code: &str) -> Result<Vec<String>> {
    let Some(secret) = session.get::<String>(SETUP_SECRET) else {
        return Err(Error::bad_request("start the setup first").with_code("setup_missing"));
    };
    let Some(step) = Totp::from_base32(&secret)?.verify(code, None) else {
        return Err(code_invalid());
    };
    let codes = recovery_codes::generate(RECOVERY_CODES);
    let hashes: Vec<String> = codes.iter().map(|c| recovery_codes::hash(c)).collect();
    sqlx::query(
        "UPDATE users SET totp_secret = $1, totp_last_step = $2, recovery_codes = $3, \
         session_version = session_version + 1 WHERE id = $4",
    )
    .bind(&secret)
    .bind(step as i64)
    .bind(hashes.join("\n"))
    .bind(user.id)
    .execute(&**db)
    .await?;
    session.remove(SETUP_SECRET);
    start_session(db, session, user).await?;
    Ok(codes)
}

/// Turns two-factor login off, with a current code (or a recovery code) so
/// a stolen session alone can't. Other sessions of the account end.
async fn disable_two_factor(db: &Db, session: &Session, user: &User, code: &str) -> Result<()> {
    let Some(state) = two_factor_state(db, user.id).await? else {
        return Err(login_required());
    };
    if state.totp_secret.is_none() {
        return Ok(());
    }
    if !use_code(db, user.id, &state, code).await? {
        return Err(code_invalid());
    }
    sqlx::query(
        "UPDATE users SET totp_secret = NULL, totp_last_step = NULL, recovery_codes = '', \
         session_version = session_version + 1 WHERE id = $1",
    )
    .bind(user.id)
    .execute(&**db)
    .await?;
    start_session(db, session, user).await
}

/// Whether `user` has two-factor login on.
async fn has_two_factor(db: &Db, user: &User) -> Result<bool> {
    Ok(two_factor_state(db, user.id).await?.is_some_and(|s| s.totp_secret.is_some()))
}

// ---- sign-in links ---------------------------------------------------------------

/// Emails a sign-in link if `email` has an account; does nothing otherwise,
/// so callers answer the same either way. The link is bound to the
/// account's sign-in count: it works once, and not after another sign-in.
async fn send_sign_in_link(
    db: &Db,
    links: &MagicLinks,
    mail: &Mailer,
    tasks: &BackgroundTasks,
    email: &str,
) -> Result<()> {
    let email = email.trim().to_lowercase();
    let row: Option<(i64, i64)> = sqlx::query_as("SELECT id, login_count FROM users WHERE email = $1")
        .bind(&email)
        .fetch_optional(&**db)
        .await?;
    let Some((id, count)) = row else {
        return Ok(());
    };
    let token = links.issue(&id.to_string(), "sign-in", &count.to_string(), LINK_TTL);
    let link = format!("{}{LINK_PATH}/{token}", app_url());
    let message = Email::to(email).subject("Your sign-in link").text(format!(
        "Sign in with this link (it works for 15 minutes, once):\n{link}\n\n\
         If you didn't ask for it, ignore this email.\n"
    ));
    let mail = mail.clone();
    tasks.spawn(async move { mail.send(message).await });
    Ok(())
}

/// Signs in with an emailed link. The link came by email, so it also proves
/// the address.
async fn sign_in_with_link(db: &Db, session: &Session, links: &MagicLinks, token: &str) -> Result<User> {
    let id: i64 = MagicLinks::user_of(token)
        .and_then(|id| id.parse().ok())
        .ok_or_else(|| Error::bad_request("this link is invalid or was already used").with_code("link_invalid"))?;
    let row: Option<(String, i64)> = sqlx::query_as("SELECT email, login_count FROM users WHERE id = $1")
        .bind(id)
        .fetch_optional(&**db)
        .await?;
    let count = row.as_ref().map(|(_, count)| count.to_string());
    links.verify(token, "sign-in", |_| count)?;
    let Some((email, _)) = row else {
        return Err(login_required());
    };
    sqlx::query("UPDATE users SET email_verified = TRUE WHERE id = $1")
        .bind(id)
        .execute(&**db)
        .await?;
    sign_in(db, session, User { id, email }).await
}

fn invalid_credentials() -> Error {
    Error::new(StatusCode::UNAUTHORIZED, "wrong email or password").with_code("invalid_credentials")
}

// ---- password reset --------------------------------------------------------------

/// Emails a reset link if `email` has an account; does nothing otherwise, so
/// callers answer the same either way.
async fn send_reset_link(db: &Db, mail: &Mailer, tasks: &BackgroundTasks, email: &str) -> Result<()> {
    let email = email.trim().to_lowercase();
    let id: Option<i64> = sqlx::query_scalar("SELECT id FROM users WHERE email = $1")
        .bind(&email)
        .fetch_optional(&**db)
        .await?;
    let Some(id) = id else {
        return Ok(());
    };
    let token = password::new_token()?;
    sqlx::query("INSERT INTO password_resets (token_hash, user_id, expires_at) VALUES ($1, $2, $3)")
        .bind(password::hash_token(&token))
        .bind(id)
        .bind(unix_now() + RESET_TTL.as_secs() as i64)
        .execute(&**db)
        .await?;
    let link = format!("{}/reset?token={token}", app_url());
    let message = Email::to(email).subject("Reset your password").text(format!(
        "Someone asked to reset the password for this account.\n\n\
         Choose a new password here (the link works for an hour, once):\n{link}\n\n\
         If it wasn't you, ignore this email: your password stays the same.\n"
    ));
    let mail = mail.clone();
    // Sent after the response, so its timing doesn't reveal which emails have accounts.
    tasks.spawn(async move { mail.send(message).await });
    Ok(())
}

/// Uses up the reset token, sets the new password and logs the user in.
async fn reset_password(db: &Db, session: &Session, form: &ResetPassword) -> Result<User> {
    // Deleting the token first means it works exactly once, even with two tabs.
    let user_id: Option<i64> = sqlx::query_scalar(
        "DELETE FROM password_resets WHERE token_hash = $1 AND expires_at > $2 RETURNING user_id",
    )
    .bind(password::hash_token(form.token.trim()))
    .bind(unix_now())
    .fetch_optional(&**db)
    .await?;
    let Some(user_id) = user_id else {
        return Err(Error::bad_request("this reset link is invalid or has expired").with_code("invalid_token"));
    };
    let hash = password::hash(form.password.as_str()).await?;
    let user = sqlx::query_as::<_, User>(
        // Bumping session_version logs out every session of this account.
        // The link came by email, so the address is the user's.
        "UPDATE users SET password_hash = $1, session_version = session_version + 1, \
         email_verified = TRUE WHERE id = $2 RETURNING id, email",
    )
    .bind(&hash)
    .bind(user_id)
    .fetch_one(&**db)
    .await?;
    // Other links sent to this account stop working too.
    sqlx::query("DELETE FROM password_resets WHERE user_id = $1")
        .bind(user_id)
        .execute(&**db)
        .await?;
    // A reset doesn't skip the second factor: a stolen inbox isn't enough.
    sign_in(db, session, user).await
}

