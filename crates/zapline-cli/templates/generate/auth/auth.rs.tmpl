/// Sign up from the page's form: go home, or show the form again.
#[post("/signup", tag = "pages")]
async fn signup_form(
    views: Views,
    db: Db,
    session: Session,
    flash: Flash,
    State(social): State<SocialLogins>,
    ValidForm(form): ValidForm<Credentials>,
) -> Result<Response> {
    let ctx = context! { providers => social.0 };
    let creds = match form {
        Ok(creds) => creds,
        Err(invalid) => return views.render_invalid("auth/signup.html", ctx, invalid),
    };
    match register(&db, &session, &creds).await {
        Ok(user) => {
            flash.success(format!("Welcome, {}!", user.email));
            Ok(flash.redirect("/"))
        }
        Err(e) if e.code() == Some("email_taken") => {
            let errors = FormErrors::one("email", "is already registered");
            views.render_invalid("auth/signup.html", ctx, Invalid::new(errors, &creds))
        }
        Err(e) => Err(e),
    }
}

/// Log in from the page's form.
#[post("/login", tag = "pages")]
async fn login_form(
    views: Views,
    db: Db,
    session: Session,
    flash: Flash,
    State(social): State<SocialLogins>,
    ValidForm(form): ValidForm<Credentials>,
) -> Result<Response> {
    let ctx = context! { providers => social.0 };
    let creds = match form {
        Ok(creds) => creds,
        Err(invalid) => return views.render_invalid("auth/login.html", ctx, invalid),
    };
    match authenticate(&db, &session, &creds).await {
        Ok(_) => {
            flash.success("You are logged in.");
            Ok(flash.redirect("/"))
        }
        Err(e) if e.code() == Some("two_factor_required") => Ok(flash.redirect("/login/2fa")),
        // "wrong email or password", above the fields.
        Err(e) if e.status().is_client_error() => {
            views.render_invalid("auth/login.html", ctx, Invalid::new(FormErrors::from_error(&e), &creds))
        }
        Err(e) => Err(e),
    }
}

