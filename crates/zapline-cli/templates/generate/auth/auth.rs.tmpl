/// The second step of logging in: the code page (back to the log-in page
/// when nothing is waiting for a code).
#[get("/login/2fa", tag = "pages")]
async fn two_factor_page(views: Views, session: Session, flash: Flash) -> Result<Response> {
    if session.get::<i64>(PENDING_USER).is_none() {
        return Ok(flash.redirect("/login"));
    }
    Ok(views.render("auth/two_factor.html", context! {})?.into_response())
}

/// Check the code and finish logging in.
#[post("/login/2fa", tag = "pages")]
async fn two_factor_form(
    views: Views,
    db: Db,
    session: Session,
    flash: Flash,
    ValidForm(form): ValidForm<TwoFactorCode>,
) -> Result<Response> {
    let form = match form {
        Ok(form) => form,
        Err(invalid) => return views.render_invalid("auth/two_factor.html", context! {}, invalid),
    };
    match complete_two_factor(&db, &session, &form.code).await {
        Ok(_) => {
            flash.success("You are logged in.");
            Ok(flash.redirect("/"))
        }
        // The pending log-in expired: start again.
        Err(e) if e.code() == Some("login_required") => {
            flash.error("That took too long. Log in again.");
            Ok(flash.redirect("/login"))
        }
        Err(e) if e.status().is_client_error() => {
            let errors = FormErrors::one("code", "isn't right");
            views.render_invalid("auth/two_factor.html", context! {}, Invalid { errors, ..Invalid::default() })
        }
        Err(e) => Err(e),
    }
}

