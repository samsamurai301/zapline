/// The `?token=` of a reset link.
#[model]
pub struct ResetLink {
    pub token: String,
}

/// The new password, from the reset page's form (the token stays in the URL).
#[model]
pub struct NewPassword {
    #[validate(length(min = 8, max = 128))]
    pub password: String,
}

/// Set the new password from the page's form, then go home logged in.
#[post("/reset", tag = "pages")]
async fn reset_form(
    views: Views,
    db: Db,
    session: Session,
    flash: Flash,
    Query(link): Query<ResetLink>,
    ValidForm(form): ValidForm<NewPassword>,
) -> Result<Response> {
    let ctx = context! { token => &link.token };
    let form = match form {
        Ok(form) => form,
        Err(invalid) => return views.render_invalid("auth/reset.html", ctx, invalid),
    };
    let new_password = ResetPassword { token: link.token.clone(), password: form.password };
    match reset_password(&db, &session, &new_password).await {
        Ok(_) => {
            flash.success("Your password is changed and you are logged in.");
            Ok(flash.redirect("/"))
        }
        Err(e) if e.code() == Some("two_factor_required") => {
            flash.success("Your password is changed.");
            Ok(flash.redirect("/login/2fa"))
        }
        Err(e) if e.status().is_client_error() => {
            views.render_invalid("auth/reset.html", ctx, Invalid { errors: FormErrors::from_error(&e), ..Invalid::default() })
        }
        Err(e) => Err(e),
    }
}

