    let setup = begin_two_factor(&session, &user)?;
    views.render("auth/security.html", context! { setup => setup })
}

/// Confirm the setup with a code; show the recovery codes once.
#[post("/account/security/enable", tag = "pages")]
async fn security_enable(
    views: Views,
    db: Db,
    session: Session,
    CurrentUser(user): CurrentUser,
    ValidForm(form): ValidForm<TwoFactorCode>,
) -> Result<Response> {
    let code = match form {
        Ok(form) => form.code,
        Err(_) => String::new(),
    };
    match enable_two_factor(&db, &session, &user, &code).await {
        Ok(codes) => Ok(views
            .render("auth/security.html", context! { enabled => true, recovery_codes => codes })?
            .into_response()),
        Err(e) if e.code() == Some("code_invalid") => {
            // Show the same secret again with the error, so the user can retry.
            let secret = session.get::<String>(SETUP_SECRET).unwrap_or_default();
            let setup = Totp::from_base32(&secret).ok().map(|totp| TwoFactorSetup {
                secret: totp.secret_base32(),
                otpauth_uri: totp.otpauth_uri(&issuer(), &user.email),
            });
            let errors = FormErrors::one("code", "isn't right");
            views.render_invalid("auth/security.html", context! { setup => setup }, Invalid { errors, ..Invalid::default() })
        }
        Err(e) => Err(e),
    }
}

/// Turn two-factor login off with a current code.
#[post("/account/security/disable", tag = "pages")]
async fn security_disable(
    views: Views,
    db: Db,
