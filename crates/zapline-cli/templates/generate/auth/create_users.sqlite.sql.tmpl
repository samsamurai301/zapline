-- Accounts for `src/routes/auth.rs`. Emails are stored lowercased.
CREATE TABLE users (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    email TEXT NOT NULL UNIQUE,
    password_hash TEXT NOT NULL,
    -- Set once the owner proves the address: a used reset or sign-in link,
    -- or a GitHub/Google login with that verified email. Admin access needs it.
    email_verified INTEGER NOT NULL DEFAULT 0,
    -- Bumped when the password or two-factor login changes, which ends every
    -- other session.
    session_version INTEGER NOT NULL DEFAULT 0,
    -- Two-factor login: the TOTP secret (base32) once it is turned on, the
    -- time step of the last accepted code (each code works once), and the
    -- SHA-256 hashes of unused recovery codes, one per line.
    totp_secret TEXT,
    totp_last_step BIGINT,
    recovery_codes TEXT NOT NULL DEFAULT '',
    -- Counts sign-ins. Emailed sign-in links are bound to it, so each one
    -- works once.
    login_count INTEGER NOT NULL DEFAULT 0,
    created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP
);

-- Password-reset links: only a SHA-256 of each token is stored.
CREATE TABLE password_resets (
    token_hash TEXT PRIMARY KEY,
    user_id INTEGER NOT NULL REFERENCES users (id) ON DELETE CASCADE,
    expires_at BIGINT NOT NULL
);

-- GitHub/Google identities linked to accounts.
CREATE TABLE oauth_accounts (
    provider TEXT NOT NULL,
    provider_id TEXT NOT NULL,
    user_id INTEGER NOT NULL REFERENCES users (id) ON DELETE CASCADE,
    PRIMARY KEY (provider, provider_id)
);
