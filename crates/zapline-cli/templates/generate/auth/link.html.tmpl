{% extends "base.html" %}
{% block title %}Email me a sign-in link · @@package@@{% endblock %}
{% block content %}
<h1>Sign in by email</h1>
{% if link_error %}<p role="alert" class="error">{{ link_error }}. Ask for a new one below.</p>{% endif %}

<form method="post" action="/login/link" hx-post="/login/link">
  {% block form %}
  {% if sent %}
  <p role="status">If {{ email }} has an account, a sign-in link is on its way. It works for 15 minutes, once.</p>
  {% else %}
  <label>Email <input type="email" name="email" value="{{ old.email }}" required autocomplete="email" autofocus{% if errors.email %} aria-invalid="true"{% endif %}></label>
  {% if errors.email %}<small class="error">Email {{ errors.email }}</small>{% endif %}
  <button>Email me a sign-in link</button>
  {% endif %}
  {% endblock %}
</form>

<p><small>Rather use your password? <a href="/login">Log in</a></small></p>
{% endblock %}
