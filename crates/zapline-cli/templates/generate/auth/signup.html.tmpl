{% extends "base.html" %}
{% block title %}Sign up · @@package@@{% endblock %}
{% block content %}
<h1>Sign up</h1>

{% for slug, label in providers %}
<p><a role="button" class="secondary" href="/auth/{{ slug }}">Continue with {{ label }}</a></p>
{% endfor %}

<form method="post" action="/signup" hx-post="/signup">
  {% block form %}
  {% if errors._form %}<p role="alert" class="error">{{ errors._form }}</p>{% endif %}
  <label>Email <input type="email" name="email" value="{{ old.email }}" required autocomplete="email" autofocus{% if errors.email %} aria-invalid="true"{% endif %}></label>
  {% if errors.email %}<small class="error">Email {{ errors.email }}</small>{% endif %}
  <label>Password <input type="password" name="password" required minlength="8" maxlength="128" autocomplete="new-password"{% if errors.password %} aria-invalid="true"{% endif %}></label>
  {% if errors.password %}<small class="error">Password {{ errors.password }}</small>{% endif %}
  <button>Sign up</button>
  {% endblock %}
</form>

<p><small>Already have an account? <a href="/login">Log in</a></small></p>
{% endblock %}
