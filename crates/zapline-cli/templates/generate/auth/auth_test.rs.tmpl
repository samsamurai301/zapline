#[tokio::test]
async fn reset_pages_work_end_to_end() {
    let client = app(Database::sqlite_memory()).test().with_cookies();
    client.post("/api/auth/signup").json(&creds("e@example.com", "old password")).send().await.assert_status(201);
    client.post("/api/auth/logout").send().await.assert_status(204);

    client.get("/login").send().await.assert_contains("href=\"/forgot\"");
    client.get("/forgot").send().await.assert_status(200).assert_contains("<h1>Reset your password</h1>");
    let sent = client
        .post("/forgot")
        .header("hx-request", "true")
        .form(&[("email", "e@example.com")])
        .send()
        .await;
    sent.assert_status(200).assert_contains("a reset link is on its way");
    let token = reset_token(&client, 0).await;

    client.get(&format!("/reset?token={token}")).send().await.assert_status(200).assert_contains(&token);
    let done = client
        .post("/reset")
        .header("hx-request", "true")
        .form(&[("token", token.as_str()), ("password", "new password")])
        .send()
        .await;
    done.assert_status(200).assert_header("hx-redirect", "/");
    client.get("/api/auth/me").send().await.assert_status(200);

    let used = client
        .post("/reset")
        .header("hx-request", "true")
        .form(&[("token", token.as_str()), ("password", "new password")])
        .send()
        .await;
    used.assert_status(200).assert_contains("invalid or has expired");
}

#[tokio::test]
async fn html_forms_redirect_or_show_the_error() {
    let client = app(Database::sqlite_memory()).test().with_cookies();
    client.get("/signup").send().await.assert_status(200).assert_contains("<h1>Sign up</h1>");
    client.get("/login").send().await.assert_status(200).assert_contains("<h1>Log in</h1>");

    let ok = client
        .post("/signup")
        .header("hx-request", "true")
        .form(&[("email", "c@example.com"), ("password", "long enough")])
        .send()
        .await;
    ok.assert_status(200).assert_header("hx-redirect", "/");
    client.get("/api/auth/me").send().await.assert_status(200);

    let bad = client
        .post("/login")
        .header("hx-request", "true")
        .form(&[("email", "c@example.com"), ("password", "wrong password")])
        .send()
        .await;
    bad.assert_status(200).assert_contains("wrong email or password");
    assert!(!bad.text().contains("<h1>"), "htmx gets only the form: {}", bad.text());
}
