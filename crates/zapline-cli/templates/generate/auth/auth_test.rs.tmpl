/// A stand-in for GitHub: every code is good and the user is octo.
async fn fake_github() -> String {
    use zapline::prelude::{App, Json};
    let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
    let addr = listener.local_addr().unwrap();
    let github = App::new()
        .post("/token", || async { Json(json!({ "access_token": "t", "token_type": "bearer" })) })
        .get("/user", || async { Json(json!({ "id": 7, "login": "octo", "email": null })) })
        .get("/user/emails", || async {
            Json(json!([{ "email": "Ada@Example.com", "primary": true, "verified": true }]))
        });
    tokio::spawn(github.serve(listener));
    format!("http://{addr}")
}

#[tokio::test]
async fn github_login_links_to_the_account_with_that_email() {
    let base = fake_github().await;
    let github = OAuth::github("id", "secret").endpoints(
        format!("{base}/authorize"),
        format!("{base}/token"),
        format!("{base}/user"),
    );
    let client = app(Database::sqlite_memory()).oauth(github).test().with_cookies();
    client
        .post("/api/auth/signup")
        .json(&creds("ada@example.com", "correct horse"))
        .send()
        .await
        .assert_status(201);
    client.post("/api/auth/logout").send().await.assert_status(204);

    // Twice: the first login links the GitHub identity, the second uses the link.
    for _ in 0..2 {
        let res = client.get("/auth/github?next=/settings").send().await;
        let location = res.header("location").unwrap();
        assert!(location.starts_with(&format!("{base}/authorize?")), "{location}");
        let state = location.split("state=").nth(1).unwrap().split('&').next().unwrap();
        let res = client
            .get(&format!("/auth/github/callback?code=c&state={state}"))
            .send()
            .await;
        assert_eq!(res.header("location"), Some("/settings"));
        let me = client.get("/api/auth/me").send().await;
        assert_eq!(me.json::<serde_json::Value>()["email"], "ada@example.com");
        client.post("/api/auth/logout").send().await.assert_status(204);
    }
}

#[tokio::test]
async fn only_admin_emails_get_into_the_admin_panel() {
    // The only test that reads ADMIN_EMAILS.
    std::env::set_var("ADMIN_EMAILS", "boss@example.com, Owner@Example.com");
    let client = app(Database::sqlite_memory()).test().with_cookies();
    // @@html
    client
        .get("/admin")
        .send()
        .await
        .assert_status(303)
        .assert_header("location", "/login");
    // html@@
    // @@api
    client.get("/admin").send().await.assert_status(401);
    // api@@

    for (email, status) in [("ada@example.com", 403), ("owner@example.com", 200)] {
        client
            .post("/api/auth/signup")
            .json(&creds(email, "correct horse"))
            .send()
            .await
            .assert_status(201);
        client.get("/admin/users").send().await.assert_status(status);
        client.post("/api/auth/logout").send().await.assert_status(204);
    }
}
