#[tokio::test]
async fn sign_in_links_work_once() {
    let client = app(Database::sqlite_memory()).test().with_cookies();
    client.post("/api/auth/signup").json(&creds("m@example.com", "long enough")).send().await.assert_status(201);
    client.post("/api/auth/logout").send().await.assert_status(204);

    // Unknown emails get the same answer and no mail.
    client.post("/api/auth/link").json(&json!({ "email": "nobody@example.com" })).send().await.assert_status(202);
    client.post("/api/auth/link").json(&json!({ "email": "M@example.com" })).send().await.assert_status(202);
    let token = link_token(&client, 0).await;

    let open = client.get(&format!("/api/auth/link/{token}")).send().await;
    open.assert_status(200);
    assert_eq!(open.json::<serde_json::Value>()["email"], "m@example.com");
    client.get("/api/auth/me").send().await.assert_status(200);

    // Used up: signing in changed what the link was bound to.
    client.post("/api/auth/logout").send().await.assert_status(204);
    let again = client.get(&format!("/api/auth/link/{token}")).send().await;
    again.assert_status(400);
    assert_eq!(again.json::<serde_json::Value>()["code"], "link_invalid");
    client.get("/api/auth/link/not-a-token").send().await.assert_status(400);
}

#[tokio::test]
async fn sessions_are_hard_to_abuse() {
    let client = app(Database::sqlite_memory()).test();
    let phone = client.clone().with_cookies();
    phone.post("/api/auth/signup").json(&creds("f@example.com", "old password")).send().await.assert_status(201);

    // Another site can't make the browser act with the session (CSRF).
    phone.post("/api/auth/logout").header("sec-fetch-site", "cross-site").send().await.assert_status(403);
    phone.get("/api/auth/me").send().await.assert_status(200);

    // Resetting the password logs out every other session.
    let laptop = client.clone().with_cookies();
    laptop.post("/api/auth/login").json(&creds("f@example.com", "old password")).send().await.assert_status(200);
    phone.post("/api/auth/forgot").json(&json!({ "email": "f@example.com" })).send().await.assert_status(202);
    let token = reset_token(&phone, 0).await;
    phone.post("/api/auth/reset").json(&json!({ "token": token, "password": "new password" })).send().await.assert_status(200);
    phone.get("/api/auth/me").send().await.assert_status(200);
    laptop.get("/api/auth/me").send().await.assert_status(401);

    // Password guessing is rate-limited (10 a minute per client, this
    // test's earlier sign-up, log-in and reset requests included).
    let guesser = client.with_cookies();
    let mut statuses = Vec::new();
    for _ in 0..8 {
        let res = guesser.post("/api/auth/login").json(&creds("f@example.com", "a guess!")).send().await;
        statuses.push(res.status().as_u16());
    }
    assert_eq!(statuses, [401, 401, 401, 401, 401, 401, 429, 429]);
}
