#[tokio::test]
async fn reset_pages_work_end_to_end() {
    let client = app(Database::sqlite_memory()).test().with_cookies();
    client.post("/api/auth/signup").json(&creds("e@example.com", "old password")).send().await.assert_status(201);
    client.post("/api/auth/logout").send().await.assert_status(204);

    client.get("/login").send().await.assert_contains("href=\"/forgot\"");
    client.get("/forgot").send().await.assert_status(200).assert_contains("<h1>Reset your password</h1>");
    let invalid = client
        .post("/forgot")
        .header("hx-request", "true")
        .form(&[("email", "e@")])
        .send()
        .await;
    invalid
        .assert_status(422)
        .assert_contains("Email must be a valid email address")
        .assert_contains("value=\"e@\"");
    let sent = client
        .post("/forgot")
        .header("hx-request", "true")
        .form(&[("email", "e@example.com")])
        .send()
        .await;
    sent.assert_status(200).assert_contains("a reset link is on its way");
    let token = reset_token(&client, 0).await;

    let page = client.get(&format!("/reset?token={token}")).send().await;
    page.assert_status(200).assert_contains(&format!("hx-post=\"/reset?token={token}\""));
    let reset_url = format!("/reset?token={token}");
    let short = client
        .post(&reset_url)
        .header("hx-request", "true")
        .form(&[("password", "short")])
        .send()
        .await;
    short.assert_status(422).assert_contains("Password length must be between 8 and 128");
    assert!(!short.text().contains("value=\"short\""), "passwords are never echoed: {}", short.text());

    let done = client
        .post(&reset_url)
        .header("hx-request", "true")
        .form(&[("password", "new password")])
        .send()
        .await;
    done.assert_status(200).assert_header("hx-redirect", "/");
    client.get("/api/auth/me").send().await.assert_status(200);

    let used = client
        .post(&reset_url)
        .header("hx-request", "true")
        .form(&[("password", "new password")])
        .send()
        .await;
    used.assert_status(422).assert_contains("invalid or has expired");
}

#[tokio::test]
async fn html_forms_redirect_with_a_flash_or_show_the_errors() {
    let client = app(Database::sqlite_memory()).test().with_cookies();
    client.get("/signup").send().await.assert_status(200).assert_contains("<h1>Sign up</h1>");
    client.get("/login").send().await.assert_status(200).assert_contains("<h1>Log in</h1>");

    // Invalid input: a 422 with only the form, a message per field, the
    // email kept and the password never echoed back.
    let invalid = client
        .post("/signup")
        .header("hx-request", "true")
        .form(&[("email", "not-an-email"), ("password", "short")])
        .send()
        .await;
    invalid
        .assert_status(422)
        .assert_contains("Email must be a valid email address")
        .assert_contains("Password length must be between 8 and 128")
        .assert_contains("value=\"not-an-email\"");
    assert!(!invalid.text().contains("<h1>"), "htmx gets only the form: {}", invalid.text());
    assert!(!invalid.text().contains("short"), "{}", invalid.text());

    let ok = client
        .post("/signup")
        .header("hx-request", "true")
        .form(&[("email", "c@example.com"), ("password", "long enough")])
        .send()
        .await;
    ok.assert_status(200).assert_header("hx-redirect", "/");
    client.get("/api/auth/me").send().await.assert_status(200);

    // A duplicate is reported on the email field.
    let other = app(Database::sqlite_memory()).test().with_cookies();
    other.post("/signup").form(&[("email", "x@example.com"), ("password", "long enough")]).send().await;
    let dup = other
        .post("/signup")
        .header("hx-request", "true")
        .form(&[("email", "X@example.com"), ("password", "long enough")])
        .send()
        .await;
    dup.assert_status(422).assert_contains("Email is already registered").assert_contains("value=\"X@example.com\"");

    let bad = client
        .post("/login")
        .header("hx-request", "true")
        .form(&[("email", "c@example.com"), ("password", "wrong password")])
        .send()
        .await;
    bad.assert_status(422).assert_contains("wrong email or password").assert_contains("value=\"c@example.com\"");
    assert!(!bad.text().contains("wrong password\""), "{}", bad.text());

    // Without htmx: a plain 303, and the next page shows the flash once.
    let res = client
        .post("/login")
        .form(&[("email", "c@example.com"), ("password", "long enough")])
        .send()
        .await;
    res.assert_status(303).assert_header("location", "/");
    client.get("/login").send().await.assert_contains("You are logged in.");
    let again = client.get("/login").send().await;
    assert!(!again.text().contains("You are logged in."), "{}", again.text());
}

#[tokio::test]
async fn two_factor_and_link_pages() {
    let client = app(Database::sqlite_memory()).test().with_cookies();
    // Logged out, the security page sends you to log in.
    client.get("/account/security").send().await.assert_status(303).assert_header("location", "/login");
    client.get("/login/2fa").send().await.assert_status(303).assert_header("location", "/login");
    client.get("/login/link").send().await.assert_status(200).assert_contains("Email me a sign-in link");

    client.post("/signup").form(&[("email", "p@example.com"), ("password", "long enough")]).send().await;
    client.get("/account/security").send().await.assert_status(200).assert_contains("Set up two-factor login");
    let setup = client.post("/account/security/setup").send().await;
    // In HTML, `/` is escaped (`otpauth:&#x2f;&#x2f;totp...`); browsers decode it.
    setup.assert_status(200).assert_contains("otpauth:");
    let page = setup.text();
    let start = page.find("<code>").unwrap() + "<code>".len();
    let secret = &page[start..start + page[start..].find("</code>").unwrap()];
    let totp = Totp::from_base32(secret).unwrap();
    let wrong = client.post("/account/security/enable").form(&[("code", "000000")]).send().await;
    wrong.assert_status(422).assert_contains("That code isn");
    let enabled = client.post("/account/security/enable").form(&[("code", totp.code_now().as_str())]).send().await;
    enabled.assert_status(200).assert_contains("Save these recovery codes");

    // Logging in now goes through the code page.
    client.post("/logout").send().await;
    let login = client.post("/login").form(&[("email", "p@example.com"), ("password", "long enough")]).send().await;
    login.assert_status(303).assert_header("location", "/login/2fa");
    client.get("/login/2fa").send().await.assert_status(200).assert_contains("Enter your code");
    client.post("/login/2fa").form(&[("code", "000000")]).send().await.assert_status(422);
    let next = totp.code_at(unix_now() + 30);
    client
        .post("/login/2fa")
        .form(&[("code", next.as_str())])
        .send()
        .await
        .assert_status(303)
        .assert_header("location", "/");
    client.get("/api/auth/me").send().await.assert_status(200);
}
