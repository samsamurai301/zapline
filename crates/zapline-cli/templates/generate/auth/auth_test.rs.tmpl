#[tokio::test]
async fn html_forms_redirect_or_show_the_error() {
    let client = app(Database::sqlite_memory()).test().with_cookies();
    client.get("/signup").send().await.assert_status(200).assert_contains("<h1>Sign up</h1>");
    client.get("/login").send().await.assert_status(200).assert_contains("<h1>Log in</h1>");

    let ok = client
        .post("/signup")
        .header("hx-request", "true")
        .form(&[("email", "c@example.com"), ("password", "long enough")])
        .send()
        .await;
    ok.assert_status(200).assert_header("hx-redirect", "/");
    client.get("/api/auth/me").send().await.assert_status(200);

    let bad = client
        .post("/login")
        .header("hx-request", "true")
        .form(&[("email", "c@example.com"), ("password", "wrong password")])
        .send()
        .await;
    bad.assert_status(200).assert_contains("wrong email or password");
    assert!(!bad.text().contains("<h1>"), "htmx gets only the form: {}", bad.text());
}
