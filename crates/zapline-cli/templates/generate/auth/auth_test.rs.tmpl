use @@crate_name@@::app;

fn creds(email: &str, password: &str) -> serde_json::Value {
    json!({ "email": email, "password": password })
}

#[tokio::test]
async fn signup_logs_in_and_logout_logs_out() {
    let client = app(Database::sqlite_memory()).test().with_cookies();
    client.get("/api/auth/me").send().await.assert_status(401);

    let res = client.post("/api/auth/signup").json(&creds("Ada@Example.com", "correct horse")).send().await;
    res.assert_status(201);
    assert_eq!(res.json::<serde_json::Value>()["email"], "ada@example.com");

    let me = client.get("/api/auth/me").send().await;
    me.assert_status(200);
    assert_eq!(me.json::<serde_json::Value>()["email"], "ada@example.com");

    client.post("/api/auth/logout").send().await.assert_status(204);
    client.get("/api/auth/me").send().await.assert_status(401);
}

#[tokio::test]
async fn login_checks_the_password() {
    // Two browsers on one app: clones share the app, `with_cookies` gives
    // each its own cookie jar.
    let client = app(Database::sqlite_memory()).test();
    let alice = client.clone().with_cookies();
    alice.post("/api/auth/signup").json(&creds("alice@example.com", "s3cret-pass")).send().await.assert_status(201);

    let other = client.with_cookies();
    let wrong = other.post("/api/auth/login").json(&creds("alice@example.com", "nope-nope")).send().await;
    wrong.assert_status(401);
    assert_eq!(wrong.json::<serde_json::Value>()["code"], "invalid_credentials");
    let unknown = other.post("/api/auth/login").json(&creds("bob@example.com", "s3cret-pass")).send().await;
    unknown.assert_status(401);

    other.post("/api/auth/login").json(&creds("ALICE@example.com", "s3cret-pass")).send().await.assert_status(200);
    other.get("/api/auth/me").send().await.assert_status(200);
}

#[tokio::test]
async fn signup_rejects_duplicates_and_weak_input() {
    let client = app(Database::sqlite_memory()).test().with_cookies();
    client.post("/api/auth/signup").json(&creds("a@example.com", "long enough")).send().await.assert_status(201);
    let dup = client.post("/api/auth/signup").json(&creds("A@example.com", "long enough")).send().await;
    dup.assert_status(409);
    assert_eq!(dup.json::<serde_json::Value>()["code"], "email_taken");
    client.post("/api/auth/signup").json(&creds("b@example.com", "short")).send().await.assert_status(422);
    client.post("/api/auth/signup").json(&creds("not-an-email", "long enough")).send().await.assert_status(422);
}
/// The token from the newest password-reset email, once there are more than
/// `resets_before` of them. Mail is sent just after the response, so wait
/// for it briefly.
async fn reset_token(client: &TestClient, resets_before: usize) -> String {
    let mailer: Mailer = client.resources().await.require().unwrap();
    for _ in 0..200 {
        let resets: Vec<String> = mailer
            .sent()
            .into_iter()
            .filter(|m| m.subject == "Reset your password")
            .filter_map(|m| m.text)
            .collect();
        if resets.len() > resets_before {
            let text = resets.last().unwrap();
            let start = text.find("token=").expect("a reset link") + "token=".len();
            return text[start..].split_whitespace().next().unwrap().to_string();
        }
        tokio::time::sleep(Duration::from_millis(10)).await;
    }
    panic!("no reset email was sent");
}

#[tokio::test]
async fn password_reset_by_email() {
    let client = app(Database::sqlite_memory()).test().with_cookies();
    client.post("/api/auth/signup").json(&creds("d@example.com", "old password")).send().await.assert_status(201);
    client.post("/api/auth/logout").send().await.assert_status(204);

    // Unknown emails get the same answer and no mail.
    client.post("/api/auth/forgot").json(&json!({ "email": "nobody@example.com" })).send().await.assert_status(202);
    client.post("/api/auth/forgot").json(&json!({ "email": "D@example.com" })).send().await.assert_status(202);
    let token = reset_token(&client, 0).await;

    let reset = |password: &str| json!({ "token": token, "password": password });
    client.post("/api/auth/reset").json(&reset("short")).send().await.assert_status(422);
    client.post("/api/auth/reset").json(&reset("new password")).send().await.assert_status(200);
    client.get("/api/auth/me").send().await.assert_status(200);

    // The link works once; the old password is gone.
    let again = client.post("/api/auth/reset").json(&reset("another one")).send().await;
    again.assert_status(400);
    assert_eq!(again.json::<serde_json::Value>()["code"], "invalid_token");
    client.post("/api/auth/logout").send().await.assert_status(204);
    client.post("/api/auth/login").json(&creds("d@example.com", "old password")).send().await.assert_status(401);
    client.post("/api/auth/login").json(&creds("d@example.com", "new password")).send().await.assert_status(200);
}

/// The token from the newest sign-in link email, once there are more than
/// `before` of them.
async fn link_token(client: &TestClient, before: usize) -> String {
    let mailer: Mailer = client.resources().await.require().unwrap();
    for _ in 0..200 {
        let links: Vec<String> = mailer
            .sent()
            .into_iter()
            .filter(|m| m.subject == "Your sign-in link")
            .filter_map(|m| m.text)
            .collect();
        if links.len() > before {
            let text = links.last().unwrap();
            let start = text.find("/link/").expect("a sign-in link") + "/link/".len();
            return text[start..].split_whitespace().next().unwrap().to_string();
        }
        tokio::time::sleep(Duration::from_millis(10)).await;
    }
    panic!("no sign-in link email was sent");
}

fn unix_now() -> u64 {
    std::time::SystemTime::now()
        .duration_since(std::time::UNIX_EPOCH)
        .unwrap()
        .as_secs()
}

/// Signs up `email` and turns two-factor login on; returns the app's TOTP
/// and the recovery codes.
async fn with_two_factor(client: &TestClient, email: &str) -> (Totp, Vec<String>) {
    client.post("/api/auth/signup").json(&creds(email, "long enough")).send().await.assert_status(201);
    let setup: serde_json::Value = client.post("/api/auth/2fa/setup").send().await.json();
    assert!(setup["otpauth_uri"].as_str().unwrap().starts_with("otpauth://totp/"));
    let totp = Totp::from_base32(setup["secret"].as_str().unwrap()).unwrap();
    // A wrong code doesn't turn it on.
    client.post("/api/auth/2fa/enable").json(&json!({ "code": "000000" })).send().await.assert_status(401);
    let enabled = client.post("/api/auth/2fa/enable").json(&json!({ "code": totp.code_now() })).send().await;
    enabled.assert_status(200);
    let codes: Vec<String> =
        serde_json::from_value(enabled.json::<serde_json::Value>()["recovery_codes"].clone()).unwrap();
    assert_eq!(codes.len(), 10);
    (totp, codes)
}

// Log-in, code and sign-up requests share the per-IP rate limit (10 a
// minute), so each test below stays under it.

/// Logs out and logs in again with the password: half-way, waiting for a code.
async fn password_step(client: &TestClient, email: &str) {
    client.post("/api/auth/logout").send().await.assert_status(204);
    let half = client.post("/api/auth/login").json(&creds(email, "long enough")).send().await;
    half.assert_status(401);
    assert_eq!(half.json::<serde_json::Value>()["code"], "two_factor_required");
    client.get("/api/auth/me").send().await.assert_status(401);
}

#[tokio::test]
async fn two_factor_login_takes_a_recovery_code_once() {
    let client = app(Database::sqlite_memory()).test().with_cookies();
    let (_totp, codes) = with_two_factor(&client, "t@example.com").await;
    password_step(&client, "t@example.com").await;
    let wrong = client.post("/api/auth/2fa").json(&json!({ "code": "000000" })).send().await;
    wrong.assert_status(401);
    assert_eq!(wrong.json::<serde_json::Value>()["code"], "code_invalid");

    client.post("/api/auth/2fa").json(&json!({ "code": codes[0] })).send().await.assert_status(200);
    client.get("/api/auth/me").send().await.assert_status(200);
    password_step(&client, "t@example.com").await;
    client.post("/api/auth/2fa").json(&json!({ "code": codes[0] })).send().await.assert_status(401);
}

#[tokio::test]
async fn two_factor_login_takes_each_app_code_once() {
    let client = app(Database::sqlite_memory()).test().with_cookies();
    let (totp, _codes) = with_two_factor(&client, "u@example.com").await;
    // The next step's code (turning it on used up the current one).
    let next = totp.code_at(unix_now() + 30);
    password_step(&client, "u@example.com").await;
    client.post("/api/auth/2fa").json(&json!({ "code": next })).send().await.assert_status(200);
    password_step(&client, "u@example.com").await;
    client.post("/api/auth/2fa").json(&json!({ "code": next })).send().await.assert_status(401);
}

#[tokio::test]
async fn turning_two_factor_off_needs_a_code() {
    let client = app(Database::sqlite_memory()).test().with_cookies();
    let (_totp, codes) = with_two_factor(&client, "v@example.com").await;
    client.post("/api/auth/2fa/disable").json(&json!({ "code": "000000" })).send().await.assert_status(401);
    client.post("/api/auth/2fa/disable").json(&json!({ "code": codes[0] })).send().await.assert_status(204);
    client.post("/api/auth/logout").send().await.assert_status(204);
    // The password is enough again.
    client.post("/api/auth/login").json(&creds("v@example.com", "long enough")).send().await.assert_status(200);
}

#[tokio::test]
async fn a_password_reset_still_asks_for_the_second_factor() {
    let client = app(Database::sqlite_memory()).test().with_cookies();
    let (_totp, codes) = with_two_factor(&client, "r@example.com").await;
    client.post("/api/auth/logout").send().await.assert_status(204);
