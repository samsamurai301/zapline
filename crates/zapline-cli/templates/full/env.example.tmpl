# Copy to `.env` and load it into your shell (e.g. `set -a; . ./.env; set +a`).

# Selects config/{APP_ENV}.toml (default: development).
APP_ENV=development

# Any setting can be overridden as APP__SECTION__KEY.
APP__SERVER__PORT=8080

# Log filter, in tracing-subscriber EnvFilter syntax.
RUST_LOG=info
