# Copy to .env and adjust. Without DATABASE_URL the app uses ./app.db (SQLite).
ADDR=0.0.0.0:8080
DATABASE_URL=sqlite://app.db?mode=rwc
# Signs session cookies; required in release builds. `openssl rand -base64 48`
SESSION_SECRET=
# Sends email (password resets). Unset in debug builds: mail shows up at /_dev/mail.
# smtps://user:pass@smtp.example.com, or smtp://localhost:1025 for Mailpit
SMTP_URL=
MAIL_FROM=no-reply@example.com
# The public address, for links in emails.
APP_URL=http://localhost:8080
# Accounts allowed into the admin panel at /admin, comma-separated.
ADMIN_EMAILS=
